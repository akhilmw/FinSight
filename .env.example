FINSIGHT_ENVIRONMENT=development
FINSIGHT_DATABASE_URL=postgresql+psycopg://finsight:change_me@localhost:5432/finsight
FINSIGHT_SEC_USER_AGENT=FinSight contact@example.com
FINSIGHT_SEC_REQUEST_TIMEOUT_SECONDS=20
FINSIGHT_SEC_REQUESTS_PER_SECOND=5

POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379

FINSIGHT_REDIS_URL=redis://localhost:6379/0
FINSIGHT_ANSWER_CACHE_TTL_SECONDS=86400
FINSIGHT_CELERY_BROKER_URL=redis://localhost:6379/1
FINSIGHT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

FINSIGHT_OPENAI_API_KEY=replace_me
FINSIGHT_EMBEDDING_MODEL=text-embedding-3-small
FINSIGHT_EMBEDDING_DIMENSIONS=1536
FINSIGHT_EMBEDDING_BATCH_SIZE=64
FINSIGHT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FINSIGHT_ANSWER_MODEL=gpt-4o-mini
